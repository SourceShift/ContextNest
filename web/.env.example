# Upstream ContextNest substrate. Vite's dev server proxies /api/* and
# /health to this URL so the dashboard can run on :5173 without CORS
# changes on the Rust server.
VITE_API_BASE_URL=http://localhost:8080

# Default session id used when the user hasn't picked one yet. Stored in
# localStorage on first edit; this is the bootstrap value.
VITE_DEFAULT_SESSION_ID=default
