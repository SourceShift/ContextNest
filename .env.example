# Server Configuration
CONTEXTNEST_SERVER_HOST=127.0.0.1
CONTEXTNEST_SERVER_PORT=8080
CONTEXTNEST_SERVER_LOG_LEVEL=info

# API Configuration
CONTEXTNEST_REST_API_ENABLED=true
CONTEXTNEST_REST_API_VERSION=v1

# Context Configuration
CONTEXTNEST_TOKEN_BUDGET=4096

# Neo4j Database Configuration
CONTEXTNEST_DATABASE_NEO4J_URI=neo4j://localhost:7687
CONTEXTNEST_DATABASE_NEO4J_USERNAME=neo4j
CONTEXTNEST_DATABASE_NEO4J_PASSWORD=contextnest123
CONTEXTNEST_DATABASE_NEO4J_DATABASE=neo4j

# Parser Configuration
CONTEXTNEST_PARSER_DART_ANALYZER_PATH=/usr/local/bin/dart
CONTEXTNEST_PARSER_CACHE_DIRECTORY=.contextnest_cache

# Embeddings Configuration
CONTEXTNEST_EMBEDDINGS_PROVIDER=openai
CONTEXTNEST_EMBEDDINGS_API_KEY=your_openai_api_key_here
CONTEXTNEST_EMBEDDINGS_MODEL=text-embedding-ada-002
CONTEXTNEST_EMBEDDINGS_DIMENSIONS=1536

# Redis Configuration (for Docker)
REDIS_PASSWORD=contextnest123
CONTEXTNEST_CACHE_REDIS_URL=redis://localhost:6379

# Docker Development Settings
COMPOSE_PROJECT_NAME=contextnest
COMPOSE_FILE=docker-compose.yml